    "lint:check": "bunx @biomejs/biome check src"
  },
  "dependencies": {
    "@elizaos/core": "2.0.0-alpha.11",
    "@privy-io/node": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
