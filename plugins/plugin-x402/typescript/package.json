{
  "name": "@elizaos/plugin-x402",
  "version": "2.0.0-alpha.11",
  "description": "x402 Solana payment verifier for Eliza routes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
